# Production settings (ADR-0051). ./raadi deploy writes the server's .env as .env.example with
# these values on top, then deploy/prod/local.env (yours, not committed: SMTP and the server).
# Nothing here is secret: passwords and keys are generated on the server or stored in OpenBao.
RAADI_ENV=production
# On the server, plain `docker compose` and ./raadi use the production overlay; the stack lives here.
COMPOSE_FILE=compose.yaml:compose.prod.yaml
DEPLOY_DIR=/home/prod/raadi
RAADI_DOMAIN=raadiso.com
PUBLIC_SCHEME=https
BIND_ADDRESS=0.0.0.0
BIND_ADDRESS_V6=::
DNS_ZONE=raadiso.com
# Somaliland on raadiso.com (ADR-0033, ADR-0040).
COUNTRY_HOSTS=raadiso.com=XS
DEFAULT_COUNTRY=XS
PRICE_INSIGHT=false
# Not routed: Keycloak's admin console, the admin console host, the dev tools and Grafana.
KEYCLOAK_ADMIN_PUBLIC=false
DEV_TOOLS_ROUTED=false
GRAFANA_ROUTED=false
# No demo users, demo listings or demo one-time codes.
SEED_DEMO_DATA=false
DEMO_USER_PASSWORD=
DEMO_OTP_SECRET=
KEYCLOAK_OTP_CODE_REUSABLE=
AUTH_LOGIN_RATE_PER_MINUTE=20
DEMO_EMAIL_DOMAIN=raadiso.com
# Error reports: a key of its own for production (public by design, it ships in the apps).
GLITCHTIP_ADMIN_EMAIL=admin@raadiso.com
GLITCHTIP_PUBLIC_KEY=9400caf5d0794c978e5b52b6da4d288c
GLITCHTIP_PROJECT_ID=1
# No identity provider for Somaliland yet: verification is unavailable (the rest works).
BANKID_MOCK=false
BANKID_ISSUER=https://auth.raadiso.com/realms/bankid-unconfigured
BANKID_BACKCHANNEL_URL=
# No payment provider yet: promotions are switched off (ADR-0051).
PAYMENTS_PROVIDER=none
VIPPS_BASE_URL=https://api.vipps.no
VIPPS_CLIENT_ID=
VIPPS_MSN=
# Expo's push service (ADR-0025).
PUSH_URL=https://exp.host/--/api/v2/push/send
SAVED_SEARCH_INTERVAL_SECONDS=300
SAVED_SEARCH_LAG_SECONDS=30
OTEL_TRACES_SAMPLER_ARG=0.1
PROMETHEUS_RETENTION=15d
LOG_LEVEL=info
TZ=Africa/Mogadishu
