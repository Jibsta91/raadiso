# Your production values (copy to deploy/prod/local.env; that file is not committed).
# The server ./raadi deploy talks to, over SSH, as the prod user (deploy/prod/setup-server.sh).
DEPLOY_HOST=
# The admin user with sudo, for ./raadi deploy setup only (e.g. an ~/.ssh/config alias).
DEPLOY_ADMIN_HOST=
# E-mail (Keycloak's sign-up verification and password resets, notifications). Sign-up needs a
# verified address, so no one can sign up until this is set. Uncomment with your provider's values;
# the password goes in the server's secrets:  ./raadi deploy secret-set smtp_password
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# Dockhand on dockhand.$RAADI_DOMAIN behind the staff sign-in (ADR-0052), if you run it on the server:
# it must join the stack's network (raadi_default).
# COMPOSE_PROFILES=dockhand
# DOCKHAND_URL=http://dockhand:3000
