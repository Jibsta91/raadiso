# Your production values (copy to deploy/prod/local.env; that file is not committed).
# The server ./raadi deploy talks to, over SSH, as the prod user (deploy/prod/setup-server.sh).
DEPLOY_HOST=
# E-mail (Keycloak's sign-up verification and password resets, notifications). Required: sign-up
# needs a verified address. The password goes in OpenBao on the server:
#   ./raadi deploy secret-set smtp_password
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
