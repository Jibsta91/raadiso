{
  "$comment": "Single source of truth for generated secrets, who may read them, per-service databases and OpenBao paths. Consumed by the init scripts in this image.",
  "secrets": [
    "postgres_superuser_password",
    "postgres_monitor_password",
    "valkey_password",
    "keycloak_db_password",
    "keycloak_admin_password",
    "grafana_admin_password",
    "grafana_oidc_client_secret",
    "identity_db_password",
    "bff_oidc_client_secret",
    "bff_session_key",
    "admin_oidc_client_secret",
    "admin_session_key",
    "admin_kc_client_secret",
    "kafka_admin_password",
    "kafka_connect_password",
    "kafka_search_password",
    "kafka_media_password",
    "kafka_monitor_password",
    "debezium_db_password",
    "apicurio_db_password",
    "registry_init_client_secret",
    "seaweedfs_media_secret",
    "seaweedfs_imgproxy_secret",
    "imgproxy_key",
    "imgproxy_salt",
    "opensearch_admin_password",
    "opensearch_search_password",
    "opensearch_monitor_password",
    "openfga_db_password",
    "openfga_key_listings",
    "openfga_key_media",
    "openfga_key_init",
    "opa_token_listings",
    "listings_db_password",
    "media_db_password",
    "messaging_db_password",
    "valkey_messaging_password",
    "notifications_db_password",
    "kafka_notifications_password",
    "notifications_kc_client_secret",
    "audit_db_password",
    "saved_db_password",
    "trust_db_password",
    "kafka_trust_password",
    "trust_bankid_client_secret",
    "trust_identity_pepper",
    "payments_db_password",
    "payments_vipps_client_secret",
    "payments_vipps_subscription_key",
    "payments_vipps_webhook_secret",
    "kafka_listings_password",
    "kafka_saved_password",
    "kafka_audit_password",
    "pangolin_server_secret",
    "pangolin_setup_token",
    "pangolin_site_secret",
    "crowdsec_bouncer_key",
    "glitchtip_db_password",
    "glitchtip_secret_key",
    "glitchtip_admin_password",
    "staff_gate_oidc_client_secret",
    "staff_gate_cookie_secret"
  ],
  "fileConsumers": {
    "postgres": {
      "uid": 999,
      "secrets": ["postgres_superuser_password"]
    },
    "valkey": {
      "uid": 999,
      "secrets": ["valkey_password", "valkey_messaging_password"]
    },
    "keycloak": {
      "uid": 1000,
      "secrets": ["keycloak_db_password", "keycloak_admin_password"]
    },
    "grafana": {
      "uid": 472,
      "secrets": ["grafana_admin_password", "grafana_oidc_client_secret"]
    },
    "otel-collector": {
      "uid": 10001,
      "secrets": [
        "postgres_monitor_password",
        "valkey_password",
        "kafka_monitor_password",
        "opensearch_monitor_password"
      ]
    },
    "kafka": {
      "uid": 1000,
      "secrets": ["kafka_admin_password"]
    },
    "kafka-init": {
      "uid": 1000,
      "secrets": [
        "kafka_admin_password",
        "kafka_connect_password",
        "kafka_search_password",
        "kafka_media_password",
        "kafka_monitor_password",
        "kafka_notifications_password",
        "kafka_trust_password",
        "kafka_listings_password",
        "kafka_saved_password",
        "kafka_audit_password"
      ]
    },
    "kafka-connect": {
      "uid": 1001,
      "secrets": ["kafka_connect_password", "debezium_db_password"]
    },
    "apicurio": {
      "uid": 1001,
      "secrets": ["apicurio_db_password"]
    },
    "seaweedfs": {
      "uid": 1000,
      "secrets": []
    },
    "imgproxy": {
      "uid": 999,
      "secrets": ["imgproxy_key", "imgproxy_salt", "seaweedfs_imgproxy_secret"]
    },
    "opensearch": {
      "uid": 1000,
      "secrets": ["opensearch_monitor_password"]
    },
    "openfga": {
      "uid": 65532,
      "secrets": []
    },
    "opa": {
      "uid": 1000,
      "secrets": []
    },
    "pangolin": {
      "uid": 65532,
      "secrets": ["pangolin_server_secret", "pangolin_setup_token"]
    },
    "pangolin-site": {
      "uid": 65532,
      "secrets": ["pangolin_site_secret"]
    },
    "pangolin-edge": {
      "uid": 65532,
      "secrets": ["crowdsec_bouncer_key"]
    },
    "crowdsec": {
      "uid": 0,
      "secrets": ["crowdsec_bouncer_key"]
    },
    "glitchtip": {
      "uid": 5000,
      "secrets": ["glitchtip_db_password", "glitchtip_secret_key", "glitchtip_admin_password"]
    },
    "staff-gate": {
      "uid": 65532,
      "secrets": ["staff_gate_oidc_client_secret"]
    }
  },
  "templates": [
    {
      "src": "seaweedfs/s3.json.tmpl",
      "consumer": "seaweedfs",
      "dest": "s3.json"
    },
    {
      "src": "opensearch/internal_users.yml.tmpl",
      "consumer": "opensearch",
      "dest": "internal_users.yml"
    },
    {
      "src": "openfga/config.yaml.tmpl",
      "consumer": "openfga",
      "dest": "config.yaml"
    },
    {
      "src": "opa/secrets.json.tmpl",
      "consumer": "opa",
      "dest": "data.json"
    },
    {
      "src": "staff-gate/oauth2-proxy.cfg.tmpl",
      "consumer": "staff-gate",
      "dest": "oauth2-proxy.cfg"
    }
  ],
  "bcrypt": [
    "opensearch_admin_password",
    "opensearch_search_password",
    "opensearch_monitor_password"
  ],
  "infraDatabases": {
    "keycloak": {
      "owner": "keycloak",
      "password": "keycloak_db_password",
      "extensions": []
    },
    "apicurio": {
      "owner": "apicurio",
      "password": "apicurio_db_password",
      "extensions": []
    },
    "openfga": {
      "owner": "openfga",
      "password": "openfga_db_password",
      "extensions": []
    },
    "glitchtip": {
      "owner": "glitchtip",
      "password": "glitchtip_db_password",
      "extensions": []
    }
  },
  "cdc": {
    "$comment": "Debezium reads the outbox table of every service with \"outbox\": true (ADR-0008).",
    "role": "debezium",
    "password": "debezium_db_password"
  },
  "services": {
    "identity-bff": {
      "uid": 65532,
      "database": "identity",
      "extensions": ["pgcrypto"],
      "migrations": "identity-bff",
      "openbao": {
        "db_password": "identity_db_password",
        "oidc_client_secret": "bff_oidc_client_secret",
        "session_key": "bff_session_key"
      },
      "shared": ["valkey"],
      "outbox": true
    },
    "admin-bff": {
      "uid": 65532,
      "openbao": {
        "db_password": "identity_db_password",
        "oidc_client_secret": "admin_oidc_client_secret",
        "session_key": "admin_session_key",
        "keycloak_client_secret": "admin_kc_client_secret"
      },
      "shared": ["valkey"]
    },
    "listings": {
      "uid": 65532,
      "database": "listings",
      "extensions": ["postgis", "pgcrypto"],
      "migrations": "listings",
      "outbox": true,
      "openbao": {
        "db_password": "listings_db_password",
        "fga_key": "openfga_key_listings",
        "opa_token": "opa_token_listings",
        "kafka_password": "kafka_listings_password"
      },
      "shared": ["imgproxy"]
    },
    "media": {
      "uid": 65532,
      "database": "media",
      "extensions": ["pgcrypto"],
      "migrations": "media",
      "outbox": true,
      "openbao": {
        "db_password": "media_db_password",
        "s3_secret": "seaweedfs_media_secret",
        "kafka_password": "kafka_media_password",
        "fga_key": "openfga_key_media"
      },
      "shared": ["imgproxy"]
    },
    "search": {
      "uid": 65532,
      "openbao": {
        "opensearch_password": "opensearch_search_password",
        "kafka_password": "kafka_search_password"
      },
      "shared": ["imgproxy"]
    },
    "messaging": {
      "uid": 65532,
      "database": "messaging",
      "migrations": "messaging",
      "outbox": true,
      "openbao": {
        "db_password": "messaging_db_password",
        "valkey_password": "valkey_messaging_password"
      },
      "shared": ["imgproxy"]
    },
    "notifications": {
      "uid": 65532,
      "database": "notifications",
      "migrations": "notifications",
      "openbao": {
        "db_password": "notifications_db_password",
        "kafka_password": "kafka_notifications_password",
        "keycloak_client_secret": "notifications_kc_client_secret"
      },
      "supplied": {
        "smtp_password": "smtp_password"
      }
    },
    "trust": {
      "uid": 65532,
      "database": "trust",
      "migrations": "trust",
      "outbox": true,
      "openbao": {
        "db_password": "trust_db_password",
        "kafka_password": "kafka_trust_password",
        "bankid_client_secret": "trust_bankid_client_secret",
        "identity_pepper": "trust_identity_pepper"
      }
    },
    "saved": {
      "uid": 65532,
      "database": "saved",
      "migrations": "saved",
      "outbox": true,
      "openbao": {
        "db_password": "saved_db_password",
        "kafka_password": "kafka_saved_password"
      },
      "shared": ["imgproxy"]
    },
    "audit": {
      "uid": 65532,
      "database": "audit",
      "migrations": "audit",
      "openbao": {
        "db_password": "audit_db_password",
        "kafka_password": "kafka_audit_password"
      }
    },
    "payments": {
      "uid": 65532,
      "database": "payments",
      "migrations": "payments",
      "outbox": true,
      "openbao": {
        "db_password": "payments_db_password",
        "vipps_client_secret": "payments_vipps_client_secret",
        "vipps_subscription_key": "payments_vipps_subscription_key",
        "vipps_webhook_secret": "payments_vipps_webhook_secret"
      }
    },
    "payments-mock": {
      "uid": 65532,
      "openbao": {
        "client_secret": "payments_vipps_client_secret",
        "subscription_key": "payments_vipps_subscription_key",
        "webhook_secret": "payments_vipps_webhook_secret"
      }
    }
  },
  "shared": {
    "valkey": {
      "password": "valkey_password"
    },
    "imgproxy": {
      "key": "imgproxy_key",
      "salt": "imgproxy_salt"
    }
  },
  "cookie": ["staff_gate_cookie_secret"]
}
