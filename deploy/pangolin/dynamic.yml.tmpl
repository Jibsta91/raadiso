# Pangolin's Traefik, file provider (ADR-0034): the Pangolin dashboard and the certificates. Rendered by
# pangolin-config into the pangolin-edge volume. Resource routes come from Pangolin's HTTP provider.
http:
  middlewares:
    badger:
      plugin:
        badger:
          disableForwardAuth: true
    redirect-to-https:
      redirectScheme:
        scheme: https
    # ADR-0035. WAF only ("appsec" mode): each request is checked against CrowdSec's virtual patches for
    # known CVEs and blocked with 403 when it matches. No IP bans: Docker Desktop's port forwarding hides
    # visitors' addresses, so every request arrives from the same Docker gateway address. If CrowdSec is
    # down the edge stays open: this is a development tunnel, and Pangolin's sign-in still applies.
    crowdsec:
      plugin:
        crowdsec:
          enabled: true
          logLevel: INFO
          crowdsecMode: appsec
          crowdsecLapiScheme: http
          crowdsecLapiHost: crowdsec:8080
          crowdsecLapiKeyFile: /run/secrets/crowdsec_bouncer_key
          crowdsecAppsecEnabled: true
          crowdsecAppsecHost: crowdsec:7422
          crowdsecAppsecFailureBlock: false
          crowdsecAppsecUnreachableBlock: false

  routers:
    dashboard-redirect:
      rule: 'Host(`${PANGOLIN_DOMAIN}`)'
      entryPoints: [web]
      middlewares: [redirect-to-https]
      service: next-service
    dashboard:
      rule: 'Host(`${PANGOLIN_DOMAIN}`) && !PathPrefix(`/api/v1`)'
      entryPoints: [websecure]
      middlewares: [badger]
      service: next-service
      tls: {}
    dashboard-api:
      rule: 'Host(`${PANGOLIN_DOMAIN}`) && PathPrefix(`/api/v1`)'
      entryPoints: [websecure]
      middlewares: [badger]
      service: api-service
      tls: {}
    # Sites and clients keep a WebSocket open to the API.
    dashboard-ws:
      rule: 'Host(`${PANGOLIN_DOMAIN}`)'
      entryPoints: [websecure]
      middlewares: [badger]
      service: api-service
      tls: {}

  services:
    next-service:
      loadBalancer:
        servers:
          - url: 'http://pangolin:3002'
    api-service:
      loadBalancer:
        servers:
          - url: 'http://pangolin:3000'

# Let's Encrypt wildcards from tunnel-certs (DNS-01): *.${RAADI_DOMAIN} and ${RAADI_DOMAIN}, and
# *.${PANGOLIN_DOMAIN} and ${PANGOLIN_DOMAIN}.
tls:
  certificates:
    - certFile: /certs/dev.crt
      keyFile: /certs/dev.key
    - certFile: /certs/pangolin.crt
      keyFile: /certs/pangolin.key
  stores:
    default:
      defaultCertificate:
        certFile: /certs/dev.crt
        keyFile: /certs/dev.key
