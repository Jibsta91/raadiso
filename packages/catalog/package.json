{
  "name": "@raadi/catalog",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Marketplace configuration per country (ADR-0040): countries, money, places, the taxonomy as data with its attribute definitions, search parameters, and the deterministic demo dataset.",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./attributes": {
      "types": "./dist/attributes.d.ts",
      "default": "./dist/attributes.js"
    },
    "./categories": {
      "types": "./dist/categories.d.ts",
      "default": "./dist/categories.js"
    },
    "./countries": {
      "types": "./dist/countries.d.ts",
      "default": "./dist/countries.js"
    },
    "./demo": {
      "types": "./dist/demo.d.ts",
      "default": "./dist/demo.js"
    },
    "./money": {
      "types": "./dist/money.d.ts",
      "default": "./dist/money.js"
    },
    "./places": {
      "types": "./dist/places.d.ts",
      "default": "./dist/places.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "tsc -p tsconfig.json && node --test --test-reporter=spec '.build/test/**/*.test.js'"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@raadi/config": "workspace:*",
    "@types/node": "24.19.1",
    "eslint": "10.11.0",
    "typescript": "6.0.3"
  }
}
