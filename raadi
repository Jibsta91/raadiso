#!/usr/bin/env bash
# Raadi command-line helper. Needs only Docker (with Compose v2) and Bash.
# The Makefile offers the same commands:  make <command>
set -euo pipefail
cd "$(dirname "$0")"

DC=(docker compose)
DEV=(docker compose -f compose.yaml -f compose.dev.yaml)
TOOL=(docker compose --progress quiet run --rm toolbox)

usage() {
  cat <<'USAGE'
Usage: ./raadi <command> [args]

Platform
  up                 start everything (detached), wait until healthy, print URLs
  down               stop the platform (keeps data)
  dev                hot-reload mode (source bind-mounted; Ctrl-C to stop)
  logs [svc...]      follow logs
  ps                 show services and health
  summary            print URLs and demo logins again
  restart <svc...>   restart services (e.g. after editing deploy/traefik/*)
  migrate            run database migrations
  clean              stop and DELETE all data volumes (asks first)

Quality (run in the toolbox container)
  lint | format | typecheck | test | test-integration | build | generate
  smoke              smoke test against the running stack
  e2e                Playwright end-to-end tests against the running stack
  security           Trivy, Gitleaks, OSV-Scanner
  iac-scan           Checkov + Trivy config + TFLint
  licenses           fail on non-OSI dependency licenses
  sbom               write SBOMs to ./sbom
  toolbox [cmd...]   shell (or command) in the toolbox

Secrets & TLS
  secret <name>      print a generated secret (e.g. keycloak_admin_password,
                     grafana_admin_password, openbao_root_token)
  secret-set <name>  store a secret you supply (input hidden), e.g. godaddy_pat
  otp                the demo staff users' current one-time code for the admin console
  ca-cert            export the dev CA to deploy/certs/raadi-dev-ca.crt
Domain (raadiso.com via GoDaddy, docs/domain.md)
  dns <server-ip> [domain] [--dry-run]
                     point domain and *.domain (default $DNS_ZONE) at a public server address
  cert [domain] [--install]
                     get or renew the Let's Encrypt wildcard for domain (default $DNS_ZONE);
                     --install makes it Traefik's certificate (on the server)
Phone (docs/mobile.md)
  phone              serve the stack on this Wi-Fi as https://$PHONE_DOMAIN and start
                     Metro for Expo Go; ./raadi up returns to raadi.localhost
USAGE
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  help|-h|--help) usage ;;
  up)
    "${DC[@]}" up -d --wait "$@"
    "${DC[@]}" logs --no-log-prefix summary | sed -n '/┌/,$p'
    ;;
  down) "${DC[@]}" down "$@" ;;
  dev) "${DEV[@]}" up --build "$@" ;;
  logs) "${DC[@]}" logs -f --tail=200 "$@" ;;
  ps) "${DC[@]}" ps -a ;;
  summary) "${DC[@]}" logs --no-log-prefix summary | sed -n '/┌/,$p' ;;
  restart) "${DC[@]}" restart "$@" ;;
  migrate) "${DC[@]}" run --rm db-init ;;
  clean)
    read -r -p "This deletes ALL Raadi data volumes (databases, secrets, certificates). Type 'delete' to continue: " answer
    [[ "$answer" == "delete" ]] && "${DC[@]}" --profile tools --profile test down -v --remove-orphans
    ;;
  smoke) "${DC[@]}" --progress quiet --profile test run --rm smoke ;;
  e2e) "${DC[@]}" --progress quiet --profile test run --rm e2e "$@" ;;
  lint|format|typecheck|test|test-integration|build|generate|security|iac-scan|licenses|sbom)
    "${TOOL[@]}" "$cmd" "$@" ;;
  toolbox)
    if (( $# )); then "${TOOL[@]}" "$@"; else "${TOOL[@]}" bash; fi ;;
  secret)
    name="${1:?usage: ./raadi secret <name>}"
    [[ "$name" =~ ^[a-z0-9_]+$ ]] || { echo "invalid secret name" >&2; exit 2; }
    path="/secrets/_master/${name}"
    [[ "$name" == openbao_root_token ]] && path=/secrets/_openbao/root_token
    "${DC[@]}" run --rm --no-deps -T --entrypoint cat secrets-init "$path"; echo
    ;;
  otp)
    # RFC 6238 (HMAC-SHA256, 6 digits, 30 s) with DEMO_OTP_SECRET, as smoke computes it (ADR-0028).
    # The script runs inside the container, so nothing in it may expand here.
    # shellcheck disable=SC2016
    "${DC[@]}" --progress quiet run --rm --no-deps -T --entrypoint bash secrets-init -c '
      c=$(( $(date +%s) / 30 )); b=""
      for i in 7 6 5 4 3 2 1 0; do b+=$(printf "\\\\x%02x" $(( (c >> (i * 8)) & 255 ))); done
      m=$(printf "%b" "$b" | openssl dgst -sha256 -mac HMAC -macopt "key:${DEMO_OTP_SECRET:?}" -r | cut -d" " -f1)
      o=$(( 16#${m:63:1} )); printf "%06d (valid for %ss)\n" $(( (16#${m:$((o * 2)):8} & 0x7fffffff) % 1000000 )) $(( 30 - $(date +%s) % 30 ))'
    ;;
  secret-set)
    name="${1:?usage: ./raadi secret-set <name>}"
    [[ "$name" =~ ^[a-z0-9_]+$ ]] || { echo "invalid secret name" >&2; exit 2; }
    if [[ -t 0 ]]; then
      read -r -s -p "Value for ${name} (input hidden): " value; echo
    else
      value="$(cat)"
    fi
    [[ -n "$value" ]] || { echo "empty value, nothing stored" >&2; exit 2; }
    # Generated secrets (in the manifest) are never overwritten: services depend on them.
    # shellcheck disable=SC2016 # $1 and $n expand inside the container, not here.
    printf '%s' "$value" | "${DC[@]}" --progress quiet run --rm --no-deps -T --entrypoint bash secrets-init -c '
      jq -e --arg n "$1" ".secrets | index(\$n)" /opt/raadi/manifest.json >/dev/null \
        && { echo "$1 is generated by the stack and cannot be set" >&2; exit 2; }
      umask 077; mkdir -p /secrets/_master; cat > "/secrets/_master/$1"' _ "$name"
    unset value
    echo "stored ${name}"
    ;;
  dns)
    ip="${1:?usage: ./raadi dns <server-ip> [domain] [--dry-run]}"; shift
    name="$(sed -n 's/^DNS_ZONE=//p' .env)"; dry=0
    for arg in "$@"; do [[ "$arg" == --dry-run ]] && dry=1 || name="$arg"; done
    TARGET_IP="$ip" DNS_NAME="$name" DRY_RUN="$dry" "${DC[@]}" --progress quiet --profile ops run --rm --no-deps dns
    ;;
  cert)
    domain="$(sed -n 's/^DNS_ZONE=//p' .env)"; install=0
    for arg in "$@"; do [[ "$arg" == --install ]] && install=1 || domain="$arg"; done
    CERT_DOMAIN="$domain" INSTALL="$install" "${DC[@]}" --progress quiet --profile ops run --rm --no-deps acme-cert
    ;;
  phone)
    lan_ip="${LAN_IP:-$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for (i = 1; i < NF; i++) if ($i == "src") print $(i + 1)}')}"
    [[ -n "$lan_ip" ]] || { echo "could not find this laptop's LAN address; run LAN_IP=<address> ./raadi phone" >&2; exit 2; }
    phone_domain="${PHONE_DOMAIN:-$(sed -n 's/^PHONE_DOMAIN=//p' .env)}"
    # Demo logins stay kari.nordmann@raadi.localhost etc., so they are the same in every mode.
    demo_domain="${DEMO_EMAIL_DOMAIN:-$(sed -n 's/^RAADI_DOMAIN=//p' .env)}"
    export LAN_IP="$lan_ip" RAADI_DOMAIN="$phone_domain" DEMO_EMAIL_DOMAIN="$demo_domain" PUBLIC_SCHEME=https BIND_ADDRESS="$lan_ip"
    "${DC[@]}" -f compose.yaml -f compose.phone.yaml up -d --wait "$@"
    cat <<PHONE

  Phone mode: https://${phone_domain}  (laptop and phone on the same Wi-Fi)
    On the phone, open Expo Go and enter:  exp://${lan_ip}:8081
    Demo logins as usual. Back to raadi.localhost:  ./raadi up
PHONE
    ;;
  ca-cert)
    mkdir -p deploy/certs
    "${DC[@]}" run --rm --no-deps -T --entrypoint cat certs-init /certs/ca.crt > deploy/certs/raadi-dev-ca.crt
    cat <<'TRUST'
Wrote deploy/certs/raadi-dev-ca.crt — trusting it is optional (plain HTTP works).
  macOS:   sudo security add-trusted-cert -d -r trustRoot -k /Library/Keychains/System.keychain deploy/certs/raadi-dev-ca.crt
  Linux:   sudo cp deploy/certs/raadi-dev-ca.crt /usr/local/share/ca-certificates/ && sudo update-ca-certificates
  Windows: certutil -addstore -f ROOT deploy\certs\raadi-dev-ca.crt
  Firefox: Settings → Privacy & Security → Certificates → Import
TRUST
    ;;
  *) echo "unknown command: $cmd" >&2; usage; exit 2 ;;
esac
