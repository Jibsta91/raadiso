#!/usr/bin/env bash
# Raadi command-line helper. Needs only Docker (with Compose v2) and Bash.
# The Makefile offers the same commands:  make <command>
set -euo pipefail
cd "$(dirname "$0")"

DC=(docker compose)
DEV=(docker compose -f compose.yaml -f compose.dev.yaml)
TOOL=(docker compose --progress quiet run --rm toolbox)

usage() {
  cat <<'USAGE'
Usage: ./raadi <command> [args]

Platform
  up                 start everything (detached), wait until healthy, print URLs
  down               stop the platform (keeps data)
  dev                hot-reload mode (source bind-mounted; Ctrl-C to stop)
  logs [svc...]      follow logs
  ps                 show services and health
  status             health, memory and CPU of every service, against the memory budget
  doctor             check this machine before 'up' (Docker, memory, disk, ports, DNS, clock)
  summary            print URLs and demo logins again
  restart <svc...>   restart services (e.g. after editing deploy/traefik/*)
  migrate            run database migrations
  clean              stop and DELETE all data volumes (asks first)

Quality (run in the toolbox container)
  lint | format | typecheck | test | test-integration | build | generate
  smoke              smoke test against the running stack
  e2e                Playwright end-to-end tests against the running stack
  security           Trivy, Gitleaks, OSV-Scanner
  iac-scan           Checkov + Trivy config + TFLint
  licenses           fail on non-OSI dependency licenses
  sbom               write SBOMs to ./sbom
  toolbox [cmd...]   shell (or command) in the toolbox

Secrets & TLS
  secret <name>      print a generated secret (e.g. keycloak_admin_password,
                     grafana_admin_password, openbao_root_token)
  secret-set <name>  store a secret you supply (input hidden), e.g. godaddy_pat
  otp                the demo staff users' current one-time code for the admin console
  ca-cert            export the dev CA to deploy/certs/raadi-dev-ca.crt
Domain (raadiso.com via GoDaddy, docs/domain.md)
  dns <server-ip> [domain] [--dry-run]
                     point domain and *.domain (default $DNS_ZONE) at a public server address
  cert [domain] [--install]
                     get or renew the Let's Encrypt wildcard for domain (default $DNS_ZONE);
                     --install makes it Traefik's certificate (on the server)
Phone (docs/mobile.md)
  phone              serve the stack on this Wi-Fi as https://$PHONE_DOMAIN and start
                     Metro for Expo Go; ./raadi up returns to raadi.localhost
USAGE
}

# --- doctor / status ---------------------------------------------------------------------------
G=$'\033[32m'; Y=$'\033[33m'; R=$'\033[31m'; B=$'\033[1m'; D=$'\033[2m'; N=$'\033[0m'
[[ -t 1 ]] || { G=; Y=; R=; B=; D=; N=; }
doctor_fail=0; doctor_warn=0
pass() { printf '  %s✔%s %s\n' "$G" "$N" "$1"; }
warn() { printf '  %s!%s %s\n    %s%s%s\n' "$Y" "$N" "$1" "$D" "$2" "$N"; doctor_warn=$((doctor_warn + 1)); }
bad() { printf '  %s✖%s %s\n    %s%s%s\n' "$R" "$N" "$1" "$D" "$2" "$N"; doctor_fail=$((doctor_fail + 1)); }
version_ge() { [[ "$(printf '%s\n%s\n' "$2" "$1" | sort -V | head -1)" == "$2" ]]; }

# Everything 'docker compose up' needs from this machine, with a fix for each problem.
doctor() {
  printf '%sRaadi doctor%s\n\n' "$B" "$N"
  if ! command -v docker >/dev/null; then
    bad "Docker is not installed" "Install Docker Desktop or Docker Engine with Compose v2 (docs/development.md)."
    return 1
  fi
  if ! docker info >/dev/null 2>&1; then
    bad "The Docker daemon does not answer" "Start Docker Desktop (Linux: systemctl --user restart docker-desktop)."
    return 1
  fi
  local server compose
  server="$(docker version --format '{{.Server.Version}}' 2>/dev/null)"
  version_ge "$server" 24.0.0 && pass "Docker Engine $server" || bad "Docker Engine $server is too old" "Raadi needs 24 or newer."
  compose="$(docker compose version --short 2>/dev/null | sed 's/^v//')"
  if [[ -z "$compose" ]]; then bad "Docker Compose v2 is missing" "Install the compose plugin (docker compose, not docker-compose)."
  elif version_ge "$compose" 2.24.0; then pass "Docker Compose $compose"
  else bad "Docker Compose $compose is too old" "Raadi needs 2.24 or newer (include, depends_on conditions)."; fi

  local mem_gib cpus
  mem_gib=$(( $(docker info --format '{{.MemTotal}}') / 1024 / 1024 / 1024 ))
  cpus="$(docker info --format '{{.NCPU}}')"
  if (( mem_gib >= 14 )); then pass "${mem_gib} GiB memory for containers"
  elif (( mem_gib >= 11 )); then warn "${mem_gib} GiB memory for containers" "Enough for the stack; 16 GiB leaves room for tests and builds (ADR-0011)."
  else bad "Only ${mem_gib} GiB memory for containers" "Give Docker 12 GiB or more (Docker Desktop: Settings > Resources)."; fi
  (( cpus >= 4 )) && pass "$cpus CPUs" || warn "$cpus CPUs" "Builds and cold starts are slow below 4."

  # Free space where images and volumes live (inside Docker Desktop's VM), measured from a container.
  local image free_gib
  image="$(docker image ls --format '{{.Repository}}:{{.Tag}}' raadi/init 2>/dev/null | head -1)"
  if [[ -n "$image" ]]; then
    free_gib=$(( $(docker run --rm --network none --entrypoint sh "$image" -c "df -Pk /etc/hostname | awk 'NR==2 {print \$4}'" 2>/dev/null || echo 0) / 1024 / 1024 ))
    if (( free_gib >= 20 )); then pass "${free_gib} GiB free for images and volumes"
    elif (( free_gib >= 8 )); then warn "${free_gib} GiB free for images and volumes" "Builds need room: docker builder prune, docker image prune."
    else bad "Only ${free_gib} GiB free for images and volumes" "'no match for platform' and failed builds follow. Run docker system prune."; fi
  else
    pass "Disk: checked after the first build"
  fi

  # Docker Desktop for Linux only shares /home with its VM.
  if [[ "$(docker info --format '{{.OperatingSystem}}')" == *"Docker Desktop"* && "$(uname -s)" == Linux && "$PWD" != /home/* ]]; then
    bad "The checkout is outside /home" "Docker Desktop for Linux shares only /home: bind mounts (dev mode, toolbox) will be empty."
  else
    pass "Checkout at $PWD"
  fi
  [[ -f .env ]] && pass ".env present" || bad ".env is missing" "Restore it from git (git checkout .env); .env.example documents it."

  local domain bind port holder
  domain="$(sed -n 's/^RAADI_DOMAIN=//p' .env)"; bind="$(sed -n 's/^BIND_ADDRESS=//p' .env)"
  for host in "$domain" "admin.$domain" "auth.$domain"; do
    if getent hosts "$host" 2>/dev/null | grep -qE '^(127\.|::1)'; then pass "$host resolves to this machine"
    elif [[ "$domain" == *.localhost ]]; then warn "$host does not resolve here" "Browsers resolve *.localhost themselves; for curl add it to /etc/hosts."
    else warn "$host does not resolve to this machine" "Expected in phone mode or on a server; check DNS (./raadi dns)."; fi
  done
  for port in 80 443; do
    holder="$(docker ps --filter "publish=$port" --format '{{.Names}}' | head -1)"
    if [[ "$holder" == raadi-traefik-* ]]; then pass "Port $port is Raadi's gateway"
    elif [[ -n "$holder" ]]; then bad "Port $port is taken by container $holder" "Stop it, or set BIND_ADDRESS in .env."
    elif command -v ss >/dev/null && ss -Hltn "sport = :$port" 2>/dev/null | grep -q .; then
      bad "Port $port on ${bind:-127.0.0.1} is in use by another program" "Find it with: sudo ss -ltnp 'sport = :$port'"
    else pass "Port $port is free"; fi
  done

  # One-time codes and token lifetimes depend on the containers' clock agreeing with yours.
  local skew
  if [[ -n "$image" ]]; then
    skew=$(( $(docker run --rm --network none --entrypoint date "$image" +%s 2>/dev/null || date +%s) - $(date +%s) ))
    (( ${skew#-} <= 5 )) && pass "Clock in step with Docker (${skew}s)" \
      || bad "Docker's clock is ${skew}s off" "One-time codes and tokens fail. Restart Docker Desktop (it re-syncs the VM clock)."
  fi

  if docker compose ps -q 2>/dev/null | grep -q .; then
    local unhealthy
    unhealthy="$(docker compose ps --format '{{.Service}} {{.Health}}' | awk '$2 == "unhealthy" {print $1}' | xargs)"
    [[ -z "$unhealthy" ]] && pass "Running stack: no unhealthy services" \
      || bad "Unhealthy: $unhealthy" "./raadi logs $unhealthy — after laptop sleep: systemctl --user restart docker-desktop."
  fi

  printf '\n'
  if (( doctor_fail )); then printf '%s%d problem(s)%s, %d warning(s).\n' "$R" "$doctor_fail" "$N" "$doctor_warn"; return 1; fi
  printf '%sReady.%s %d warning(s). Next: ./raadi up\n' "$G" "$N" "$doctor_warn"
}

# A one-screen view of the running stack: health, memory against each limit, CPU.
status() {
  local stats
  stats="$(docker stats --no-stream --format '{{.Name}}|{{.MemUsage}}|{{.CPUPerc}}' 2>/dev/null)"
  printf '%s%-24s %-10s %-22s %7s%s\n' "$B" SERVICE HEALTH "MEMORY (USED / LIMIT)" CPU "$N"
  docker compose ps --format '{{.Name}}|{{.Service}}|{{.State}}|{{.Health}}' | sort -t'|' -k2 \
    | while IFS='|' read -r name service state health; do
      local line mem cpu colour=$G label="${health:-$state}"
      line="$(grep "^$name|" <<<"$stats")"; mem="$(cut -d'|' -f2 <<<"$line")"; cpu="$(cut -d'|' -f3 <<<"$line")"
      [[ "$label" == healthy || "$label" == running ]] || colour=$Y
      [[ "$label" == unhealthy || "$state" == exited ]] && colour=$R
      printf '%-24s %s%-10s%s %-22s %7s\n' "$service" "$colour" "$label" "$N" "${mem:--}" "${cpu:--}"
    done
  local total
  total="$(docker stats --no-stream --format '{{.MemUsage}}' | awk '{u=$1; if (u ~ /GiB/) v=u+0; else if (u ~ /MiB/) v=(u+0)/1024; else v=(u+0)/1048576; s+=v} END {printf "%.1f", s}')"
  printf '\n%sIn use: %s GiB of %s GiB%s (budget: ADR-0011)\n' "$B" "$total" \
    "$(( $(docker info --format '{{.MemTotal}}') / 1024 / 1024 / 1024 ))" "$N"
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  help|-h|--help) usage ;;
  up)
    # Fail early with a fix instead of halfway through a cold start (RAADI_SKIP_DOCTOR=1 skips).
    if [[ -z "${RAADI_SKIP_DOCTOR:-}" ]] && ! doctor >/tmp/raadi-doctor.$$ 2>&1; then
      cat /tmp/raadi-doctor.$$; rm -f /tmp/raadi-doctor.$$; exit 1
    fi
    rm -f /tmp/raadi-doctor.$$
    "${DC[@]}" up -d --wait "$@"
    "${DC[@]}" logs --no-log-prefix summary | sed -n '/┌/,$p'
    ;;
  down) "${DC[@]}" down "$@" ;;
  dev) "${DEV[@]}" up --build "$@" ;;
  logs) "${DC[@]}" logs -f --tail=200 "$@" ;;
  ps) "${DC[@]}" ps -a ;;
  status) status ;;
  doctor) doctor ;;
  summary) "${DC[@]}" logs --no-log-prefix summary | sed -n '/┌/,$p' ;;
  restart) "${DC[@]}" restart "$@" ;;
  migrate) "${DC[@]}" run --rm db-init ;;
  clean)
    read -r -p "This deletes ALL Raadi data volumes (databases, secrets, certificates). Type 'delete' to continue: " answer
    [[ "$answer" == "delete" ]] && "${DC[@]}" --profile tools --profile test down -v --remove-orphans
    ;;
  smoke) "${DC[@]}" --progress quiet --profile test run --rm smoke ;;
  e2e) "${DC[@]}" --progress quiet --profile test run --rm e2e "$@" ;;
  lint|format|typecheck|test|test-integration|build|generate|security|iac-scan|licenses|sbom)
    "${TOOL[@]}" "$cmd" "$@" ;;
  toolbox)
    if (( $# )); then "${TOOL[@]}" "$@"; else "${TOOL[@]}" bash; fi ;;
  secret)
    name="${1:?usage: ./raadi secret <name>}"
    [[ "$name" =~ ^[a-z0-9_]+$ ]] || { echo "invalid secret name" >&2; exit 2; }
    path="/secrets/_master/${name}"
    [[ "$name" == openbao_root_token ]] && path=/secrets/_openbao/root_token
    "${DC[@]}" run --rm --no-deps -T --entrypoint cat secrets-init "$path"; echo
    ;;
  otp)
    # RFC 6238 (HMAC-SHA256, 6 digits, 30 s) with DEMO_OTP_SECRET, as smoke computes it (ADR-0028).
    # The script runs inside the container, so nothing in it may expand here.
    # shellcheck disable=SC2016
    "${DC[@]}" --progress quiet run --rm --no-deps -T --entrypoint bash secrets-init -c '
      c=$(( $(date +%s) / 30 )); b=""
      for i in 7 6 5 4 3 2 1 0; do b+=$(printf "\\\\x%02x" $(( (c >> (i * 8)) & 255 ))); done
      m=$(printf "%b" "$b" | openssl dgst -sha256 -mac HMAC -macopt "key:${DEMO_OTP_SECRET:?}" -r | cut -d" " -f1)
      o=$(( 16#${m:63:1} )); printf "%06d (valid for %ss)\n" $(( (16#${m:$((o * 2)):8} & 0x7fffffff) % 1000000 )) $(( 30 - $(date +%s) % 30 ))'
    ;;
  secret-set)
    name="${1:?usage: ./raadi secret-set <name>}"
    [[ "$name" =~ ^[a-z0-9_]+$ ]] || { echo "invalid secret name" >&2; exit 2; }
    if [[ -t 0 ]]; then
      read -r -s -p "Value for ${name} (input hidden): " value; echo
    else
      value="$(cat)"
    fi
    [[ -n "$value" ]] || { echo "empty value, nothing stored" >&2; exit 2; }
    # Generated secrets (in the manifest) are never overwritten: services depend on them.
    # shellcheck disable=SC2016 # $1 and $n expand inside the container, not here.
    printf '%s' "$value" | "${DC[@]}" --progress quiet run --rm --no-deps -T --entrypoint bash secrets-init -c '
      jq -e --arg n "$1" ".secrets | index(\$n)" /opt/raadi/manifest.json >/dev/null \
        && { echo "$1 is generated by the stack and cannot be set" >&2; exit 2; }
      umask 077; mkdir -p /secrets/_master; cat > "/secrets/_master/$1"' _ "$name"
    unset value
    echo "stored ${name}"
    ;;
  dns)
    ip="${1:?usage: ./raadi dns <server-ip> [domain] [--dry-run]}"; shift
    name="$(sed -n 's/^DNS_ZONE=//p' .env)"; dry=0
    for arg in "$@"; do [[ "$arg" == --dry-run ]] && dry=1 || name="$arg"; done
    TARGET_IP="$ip" DNS_NAME="$name" DRY_RUN="$dry" "${DC[@]}" --progress quiet --profile ops run --rm --no-deps dns
    ;;
  cert)
    domain="$(sed -n 's/^DNS_ZONE=//p' .env)"; install=0
    for arg in "$@"; do [[ "$arg" == --install ]] && install=1 || domain="$arg"; done
    CERT_DOMAIN="$domain" INSTALL="$install" "${DC[@]}" --progress quiet --profile ops run --rm --no-deps acme-cert
    ;;
  phone)
    lan_ip="${LAN_IP:-$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for (i = 1; i < NF; i++) if ($i == "src") print $(i + 1)}')}"
    [[ -n "$lan_ip" ]] || { echo "could not find this laptop's LAN address; run LAN_IP=<address> ./raadi phone" >&2; exit 2; }
    phone_domain="${PHONE_DOMAIN:-$(sed -n 's/^PHONE_DOMAIN=//p' .env)}"
    # Demo logins stay kari.nordmann@raadi.localhost etc., so they are the same in every mode.
    demo_domain="${DEMO_EMAIL_DOMAIN:-$(sed -n 's/^RAADI_DOMAIN=//p' .env)}"
    export LAN_IP="$lan_ip" RAADI_DOMAIN="$phone_domain" DEMO_EMAIL_DOMAIN="$demo_domain" PUBLIC_SCHEME=https BIND_ADDRESS="$lan_ip"
    # Everyone on the Wi-Fi can reach the gateway, and the demo passwords and the staff one-time-code
    # secret are public in this repository. So the admin console, Keycloak's admin console and the dev
    # tools (Mailpit, OpenBao, Traefik, Prometheus) stay off the network; PHONE_TOOLS=1 keeps them.
    if [[ "${PHONE_TOOLS:-}" != 1 ]]; then export DEV_TOOLS_ROUTED=false KEYCLOAK_ADMIN_PUBLIC=false; fi
    "${DC[@]}" -f compose.yaml -f compose.phone.yaml up -d --wait "$@"
    tools="off the network (PHONE_TOOLS=1 ./raadi phone serves them)"
    [[ "${PHONE_TOOLS:-}" == 1 ]] && tools="ON: anyone on this Wi-Fi can sign in to them with the demo logins"
    cat <<PHONE

  Phone mode: https://${phone_domain}  (laptop and phone on the same Wi-Fi)
    On the phone, open Expo Go and enter:  exp://${lan_ip}:8081
    Demo logins as usual. Back to raadi.localhost:  ./raadi up
    Admin console and dev tools: ${tools}
PHONE
    ;;
  ca-cert)
    mkdir -p deploy/certs
    "${DC[@]}" run --rm --no-deps -T --entrypoint cat certs-init /certs/ca.crt > deploy/certs/raadi-dev-ca.crt
    cat <<'TRUST'
Wrote deploy/certs/raadi-dev-ca.crt — trusting it is optional (plain HTTP works).
  macOS:   sudo security add-trusted-cert -d -r trustRoot -k /Library/Keychains/System.keychain deploy/certs/raadi-dev-ca.crt
  Linux:   sudo cp deploy/certs/raadi-dev-ca.crt /usr/local/share/ca-certificates/ && sudo update-ca-certificates
  Windows: certutil -addstore -f ROOT deploy\certs\raadi-dev-ca.crt
  Firefox: Settings → Privacy & Security → Certificates → Import
TRUST
    ;;
  *) echo "unknown command: $cmd" >&2; usage; exit 2 ;;
esac
