{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests",
    "docker:pinDigests"
  ],
  "timezone": "Europe/Oslo",
  "schedule": ["before 7am on monday"],
  "dependencyDashboard": true,
  "rangeStrategy": "pin",
  "docker-compose": {
    "enabled": true,
    "managerFilePatterns": ["/(^|/)compose[^/]*\\.ya?ml$/", "/^deploy/compose/[^/]+\\.ya?ml$/"]
  },
  "dockerfile": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Versions marked with a '# renovate:' comment: toolbox CLIs (ARG <TOOL>_VERSION) and Pangolin's Traefik plugins",
      "managerFilePatterns": ["/(^|/)Dockerfile$/", "/^deploy/pangolin/traefik\\.yml$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(\\s+extractVersion=(?<extractVersion>\\S+))?\\s*\\n\\s*(ARG\\s+[A-Z_]+=|version:\\s*)(?<currentValue>\\S+)"
      ],
      "extractVersionTemplate": "{{#if extractVersion}}{{{extractVersion}}}{{else}}^(?<version>.+)${{/if}}"
    },
    {
      "customType": "regex",
      "description": "Playwright MCP image for AI coding sessions (.mcp.json)",
      "managerFilePatterns": ["/^\\.mcp\\.json$/"],
      "matchStrings": [
        "\"(?<depName>mcr\\.microsoft\\.com/playwright/mcp):(?<currentValue>v[\\d.]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Images pinned inside workflow run steps (docker run in .github/workflows)",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "\\s(?<depName>[a-z0-9.-]+/[a-z0-9./-]+):(?<currentValue>[A-Za-z0-9._-]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "groupName": "OpenTelemetry (JS)",
      "matchPackageNames": ["@opentelemetry/**"]
    },
    {
      "groupName": "NestJS",
      "matchPackageNames": ["@nestjs/**"]
    },
    {
      "groupName": "Next.js + React",
      "matchPackageNames": [
        "next",
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom",
        "eslint-config-next"
      ]
    },
    {
      "groupName": "Grafana LGTM stack",
      "matchPackageNames": ["grafana/**", "prom/**", "otel/**"]
    },
    {
      "description": "Keep TypeScript on 6.x until typescript-eslint supports 7 (ADR-0010)",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<6.1"
    },
    {
      "description": "Stay on the Node.js 24 LTS line",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["node"],
      "allowedVersions": "<25"
    },
    {
      "description": "Images change what runs: CI runs the full stack on these pull requests (ADR-0036)",
      "matchManagers": ["docker-compose", "dockerfile"],
      "addLabels": ["full-stack"]
    },
    {
      "description": "The Expo SDK moves as one: upgrade it with expo upgrade (docs/mobile.md), not package by package",
      "matchFileNames": ["apps/mobile/package.json"],
      "matchPackageNames": [
        "expo",
        "expo-*",
        "@expo/*",
        "react-native",
        "react-native-*",
        "@react-native/*",
        "react",
        "react-dom"
      ],
      "enabled": false
    },
    {
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ],
  "description": "Dependency updates as pull requests (ADR-0037): ./raadi renovate, or weekly on the self-hosted runner."
}
