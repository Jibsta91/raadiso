# =============================================================================
#  Raadi configuration reference. Copy to .env and adjust.
#  Development: the committed .env already holds working defaults.
#  Production: create .env on the server (chmod 600) — see docs/deploy.md.
#  Secrets never go in this file; they are generated on first boot.
# =============================================================================

# --- Compose / release -------------------------------------------------------
# Compose project name (prefix for containers, volumes and networks).
COMPOSE_PROJECT_NAME=raadi
# development | staging | production. Exported to logs/traces as
# deployment.environment.name and switches dev-only behaviour.
RAADI_ENV=development
# Image tag. "dev" for local builds; a release tag (e.g. v1.4.0) in production.
RAADI_VERSION=dev
# Image name prefix. Local builds: "raadi". CI/production: ghcr.io/<owner>/raadi
RAADI_IMAGE_PREFIX=raadi

# --- Public endpoints --------------------------------------------------------
# Base domain. Subdomains used: auth., grafana. (+ traefik., mail., bao.,
# prometheus. in development). *.localhost resolves without hosts-file edits.
RAADI_DOMAIN=raadi.localhost
# Scheme used in public URLs and OIDC redirect URIs (http | https).
PUBLIC_SCHEME=http
# Set to ":8080" (etc.) when HTTP_PORT is not 80, so generated URLs include it.
PUBLIC_PORT_SUFFIX=
# Host interface the gateway binds to. 127.0.0.1 in development (not exposed to
# the LAN), 0.0.0.0 in production.
BIND_ADDRESS=127.0.0.1
# IPv6 counterpart. Many hosts resolve *.localhost to ::1 first. Use :: in production.
BIND_ADDRESS_V6=::1
# Host ports for the gateway.
HTTP_PORT=80
HTTPS_PORT=443
# Phone mode (./raadi phone, docs/mobile.md): the stack answers as https://$PHONE_DOMAIN, a
# subdomain of DNS_ZONE whose DNS (GoDaddy) points at this laptop's LAN address. DNS_ZONE is the
# GoDaddy zone that ./raadi dns and ./raadi cert manage (production: raadiso.com itself).
PHONE_DOMAIN=dev.raadiso.com
DNS_ZONE=raadiso.com
# Tunnel mode (./raadi tunnel, ADR-0034): Pangolin on this laptop makes $PHONE_DOMAIN reachable from
# anywhere (the home router forwards TCP 80/443 and UDP 51820/21820 to the laptop). PANGOLIN_DOMAIN is
# its dashboard and the address the Pangolin app connects to; PANGOLIN_ADMIN_EMAIL is the admin's login
# (no mail is sent to it). Metro is https://metro.$PHONE_DOMAIN, over the Pangolin VPN.
PANGOLIN_DOMAIN=pangolin.raadiso.com
PANGOLIN_ADMIN_EMAIL=admin@raadiso.com
# The repository the self-hosted CI runner serves (./raadi runner, ADR-0036). Not a secret.
GITHUB_REPOSITORY=Jibsta91/raadiso
# The Expo project phone mode links the app to (expo.dev); Expo Go on an iPhone needs it, plus
# ./raadi secret-set expo_token for the same account. Not secrets.
EXPO_OWNER=jibstas-team
EXPO_SLUG=jibsta
EAS_PROJECT_ID=d70f34f3-837b-44e0-a917-1bcf8c1c0653
# Domain of the demo users' e-mail logins (kari.nordmann@...). Phone mode keeps the normal one.
DEMO_EMAIL_DOMAIN=${RAADI_DOMAIN}
# Derived public URLs (override only for unusual setups).
PUBLIC_BASE_URL=${PUBLIC_SCHEME}://${RAADI_DOMAIN}${PUBLIC_PORT_SUFFIX}
AUTH_BASE_URL=${PUBLIC_SCHEME}://auth.${RAADI_DOMAIN}${PUBLIC_PORT_SUFFIX}
# The admin console's own host (ADR-0028): staff only, its own session.
ADMIN_BASE_URL=${PUBLIC_SCHEME}://admin.${RAADI_DOMAIN}${PUBLIC_PORT_SUFFIX}
GRAFANA_BASE_URL=${PUBLIC_SCHEME}://grafana.${RAADI_DOMAIN}${PUBLIC_PORT_SUFFIX}

# --- Identity ----------------------------------------------------------------
# Keycloak realm for marketplace users.
KEYCLOAK_REALM=raadi
# Route the Keycloak admin console through the gateway (false in production;
# use an SSH tunnel instead).
KEYCLOAK_ADMIN_PUBLIC=true
# Route the admin console host and the dev tools (Traefik dashboard, Mailpit, OpenBao UI,
# Prometheus). ./raadi phone sets it to false, because the gateway is then on the Wi-Fi and the demo
# logins are public (PHONE_TOOLS=1 ./raadi phone keeps them).
DEV_TOOLS_ROUTED=true

# --- Seed data ---------------------------------------------------------------
# Create demo users (and, from Phase 2, demo listings). Must be false in production.
SEED_DEMO_DATA=true
# Password for all demo users (public, development only).
DEMO_USER_PASSWORD=raadi-demo-pass
# Demo staff users' authenticator for the admin console's one-time codes (ADR-0028). Development
# only, like the demo password: add it to an authenticator app as a TOTP key (HMAC-SHA256, 6 digits,
# 30 s; the app wants it base32-encoded), or let the tests compute the codes.
DEMO_OTP_SECRET=raadi-demo-otp-secret

# --- E-mail ------------------------------------------------------------------
# Outgoing mail for Keycloak (verification, password reset) and notifications.
# Development: Mailpit catches everything (http://mail.raadi.localhost).
# Production: your provider's SMTP host and port; set SMTP_SECURE=true for
# implicit TLS (465). With SMTP_USER set, the password is read from OpenBao
# (raadi/notifications, key smtp_password), never from this file.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=

# --- Identity verification (BankID) -------------------------------------------
# The trust service verifies people over OIDC (ADR-0018). Development uses a
# mock: the "bankid-mock" realm in the local Keycloak, with synthetic test
# people (see README). Production: BANKID_MOCK=false, BANKID_ISSUER and
# BANKID_CLIENT_ID from your BankID OIDC provider, BANKID_BACKCHANNEL_URL
# empty. The client secret is read from OpenBao (raadi/trust, key
# bankid_client_secret), never from this file.
BANKID_MOCK=true
BANKID_ISSUER=${AUTH_BASE_URL}/realms/bankid-mock
BANKID_CLIENT_ID=raadi
BANKID_BACKCHANNEL_URL=http://keycloak:8080/realms/bankid-mock

# --- Payments --------------------------------------------------------------------
# Promoted listings (ADR-0020). Development uses payments-mock, a Vipps-compatible
# stand-in (hosted page at http://pay.raadi.localhost). Production: VIPPS_BASE_URL
# https://api.vipps.no (test: https://apitest.vipps.no), your client id and merchant
# serial number; the client secret, subscription key and webhook secret come from
# OpenBao (raadi/payments). PAYMENTS_PROVIDER=stripe switches to Stripe Checkout
# (keys stripe_secret_key and stripe_webhook_secret in OpenBao).
PAYMENTS_PROVIDER=vipps
VIPPS_BASE_URL=http://payments-mock:4000
VIPPS_CLIENT_ID=raadi-dev
VIPPS_MSN=123456

# --- Push notifications -----------------------------------------------------------
# Pushes to the mobile app (ADR-0025). Development uses push-mock, an Expo-compatible
# stand-in (what arrived: http://push.raadi.localhost/messages). Production:
# PUSH_URL=https://exp.host/--/api/v2/push/send; if the Expo project has "enhanced
# push security" on, store its access token in OpenBao (raadi/notifications, key
# push_access_token).
PUSH_URL=http://push-mock:4000/--/api/v2/push/send

# --- Favourites and saved searches ------------------------------------------------
# How often each saved search is checked for new listings (ADR-0026). Short in
# development so alerts show up quickly; use 300 (five minutes) or more in production.
SAVED_SEARCH_INTERVAL_SECONDS=20

# --- Media -------------------------------------------------------------------
# Let ClamAV's freshclam fetch signature updates. The image ships a database,
# so scanning works offline; set false on air-gapped hosts to silence retries.
CLAMAV_FRESHCLAM=true

# --- Observability -----------------------------------------------------------
# Service log level: trace | debug | info | warn | error.
LOG_LEVEL=info
# Fraction of traces sampled (parent-based). 1.0 in dev, ~0.1 in production.
OTEL_TRACES_SAMPLER_ARG=1.0
# Prometheus TSDB retention.
PROMETHEUS_RETENTION=7d
# Container time zone (logs use UTC timestamps regardless).
TZ=Europe/Oslo
