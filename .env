# =============================================================================
#  Raadi — DEVELOPMENT DEFAULTS · NOT FOR PRODUCTION
# -----------------------------------------------------------------------------
#  Committed on purpose so that `git clone && docker compose up` just works.
#  It contains NO secrets: every password, key and client secret is generated
#  randomly on first boot (secrets-init) and kept in OpenBao / the secrets
#  volume. The only credential here is the public demo-user password.
#  Production servers get their own .env (chmod 600, never in Git) — see
#  docs/deploy.md. Every variable is documented in .env.example.
# =============================================================================

COMPOSE_PROJECT_NAME=raadi
RAADI_ENV=development
RAADI_VERSION=dev
RAADI_IMAGE_PREFIX=raadi

RAADI_DOMAIN=raadi.localhost
PUBLIC_SCHEME=http
PUBLIC_PORT_SUFFIX=
BIND_ADDRESS=127.0.0.1
BIND_ADDRESS_V6=::1
HTTP_PORT=80
HTTPS_PORT=443
PHONE_DOMAIN=dev.raadiso.com
DNS_ZONE=raadiso.com
PANGOLIN_DOMAIN=pangolin.raadiso.com
PANGOLIN_ADMIN_EMAIL=admin@raadiso.com
GITHUB_REPOSITORY=Jibsta91/raadiso
EXPO_OWNER=jibstas-team
EXPO_SLUG=jibsta
EAS_PROJECT_ID=d70f34f3-837b-44e0-a917-1bcf8c1c0653
DEMO_EMAIL_DOMAIN=${RAADI_DOMAIN}
PUBLIC_BASE_URL=${PUBLIC_SCHEME}://${RAADI_DOMAIN}${PUBLIC_PORT_SUFFIX}
AUTH_BASE_URL=${PUBLIC_SCHEME}://auth.${RAADI_DOMAIN}${PUBLIC_PORT_SUFFIX}
# The admin console's own host (ADR-0028): staff only, its own session.
ADMIN_BASE_URL=${PUBLIC_SCHEME}://admin.${RAADI_DOMAIN}${PUBLIC_PORT_SUFFIX}
GRAFANA_BASE_URL=${PUBLIC_SCHEME}://grafana.${RAADI_DOMAIN}${PUBLIC_PORT_SUFFIX}

KEYCLOAK_REALM=raadi
KEYCLOAK_ADMIN_PUBLIC=true

# Countries (ADR-0040): which host serves which country ("raadiso.com=XS,no.raadi.localhost=NO"), and the
# country of a request that names none. Development stays Norway until the second dev host exists.
COUNTRY_HOSTS=
DEFAULT_COUNTRY=NO
# Price insight (ADR-0043): price check, deal badges, sellers' price guide. Off (ADR-0050).
PRICE_INSIGHT=false
DEV_TOOLS_ROUTED=true
GRAFANA_ROUTED=true

SEED_DEMO_DATA=true
DEMO_USER_PASSWORD=raadi-demo-pass
# Error reports (GlitchTip, ADR-0038). A DSN's key is public by design (it ships in the apps), so the dev one
# is fixed here; the website and the app send to /errors/ on the site's own address (empty: off).
GLITCHTIP_ADMIN_EMAIL=admin@raadi.localhost
GLITCHTIP_PUBLIC_KEY=7b464e913d6a4e289474433ec1868a6d
GLITCHTIP_PROJECT_ID=1
# Demo staff users' authenticator for the admin console's one-time codes (ADR-0028). Development
# only, like the demo password: add it to an authenticator app as a TOTP key (HMAC-SHA256, 6 digits,
# 30 s; the app wants it base32-encoded), or let the tests compute the codes.
DEMO_OTP_SECRET=raadi-demo-otp-secret
# Development only: a one-time code may be used again within its 30 s window, so tests can sign the same
# staff user in several times in a row. Production leaves it unset (codes are single-use).
KEYCLOAK_OTP_CODE_REUSABLE=true
# Sign-ins per minute per address at the BFFs (production: 20). Smoke and e2e sign in from one address.
AUTH_LOGIN_RATE_PER_MINUTE=120
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=

BANKID_MOCK=true
BANKID_ISSUER=${AUTH_BASE_URL}/realms/bankid-mock
BANKID_CLIENT_ID=raadi
BANKID_BACKCHANNEL_URL=http://keycloak:8080/realms/bankid-mock

PAYMENTS_PROVIDER=vipps
VIPPS_BASE_URL=http://payments-mock:4000
VIPPS_CLIENT_ID=raadi-dev
VIPPS_MSN=123456
PUSH_URL=http://push-mock:4000/--/api/v2/push/send
SAVED_SEARCH_INTERVAL_SECONDS=15
# How far behind "now" the matcher looks, so listings still being indexed aren't missed (default 30 s;
# indexing takes a few seconds in development).
SAVED_SEARCH_LAG_SECONDS=10

CLAMAV_FRESHCLAM=true

LOG_LEVEL=info
OTEL_TRACES_SAMPLER_ARG=1.0
PROMETHEUS_RETENTION=7d
TZ=Europe/Oslo

