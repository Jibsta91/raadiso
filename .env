# =============================================================================
#  Raadi — DEVELOPMENT DEFAULTS · NOT FOR PRODUCTION
# -----------------------------------------------------------------------------
#  Committed on purpose so that `git clone && docker compose up` just works.
#  It contains NO secrets: every password, key and client secret is generated
#  randomly on first boot (secrets-init) and kept in OpenBao / the secrets
#  volume. The only credential here is the public demo-user password.
#  Production servers get their own .env (chmod 600, never in Git) — see
#  docs/deploy.md. Every variable is documented in .env.example.
# =============================================================================

COMPOSE_PROJECT_NAME=raadi
RAADI_ENV=development
RAADI_VERSION=dev
RAADI_IMAGE_PREFIX=raadi

RAADI_DOMAIN=raadi.localhost
PUBLIC_SCHEME=http
PUBLIC_PORT_SUFFIX=
BIND_ADDRESS=127.0.0.1
BIND_ADDRESS_V6=::1
HTTP_PORT=80
HTTPS_PORT=443
PHONE_DOMAIN=dev.raadiso.com
DNS_ZONE=raadiso.com
EXPO_OWNER=jibstas-team
EXPO_SLUG=jibsta
EAS_PROJECT_ID=d70f34f3-837b-44e0-a917-1bcf8c1c0653
DEMO_EMAIL_DOMAIN=${RAADI_DOMAIN}
PUBLIC_BASE_URL=${PUBLIC_SCHEME}://${RAADI_DOMAIN}${PUBLIC_PORT_SUFFIX}
AUTH_BASE_URL=${PUBLIC_SCHEME}://auth.${RAADI_DOMAIN}${PUBLIC_PORT_SUFFIX}
# The admin console's own host (ADR-0028): staff only, its own session.
ADMIN_BASE_URL=${PUBLIC_SCHEME}://admin.${RAADI_DOMAIN}${PUBLIC_PORT_SUFFIX}
GRAFANA_BASE_URL=${PUBLIC_SCHEME}://grafana.${RAADI_DOMAIN}${PUBLIC_PORT_SUFFIX}

KEYCLOAK_REALM=raadi
KEYCLOAK_ADMIN_PUBLIC=true

SEED_DEMO_DATA=true
DEMO_USER_PASSWORD=raadi-demo-pass
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=

BANKID_MOCK=true
BANKID_ISSUER=${AUTH_BASE_URL}/realms/bankid-mock
BANKID_CLIENT_ID=raadi
BANKID_BACKCHANNEL_URL=http://keycloak:8080/realms/bankid-mock

PAYMENTS_PROVIDER=vipps
VIPPS_BASE_URL=http://payments-mock:4000
VIPPS_CLIENT_ID=raadi-dev
VIPPS_MSN=123456
PUSH_URL=http://push-mock:4000/--/api/v2/push/send
SAVED_SEARCH_INTERVAL_SECONDS=20

CLAMAV_FRESHCLAM=true

LOG_LEVEL=info
OTEL_TRACES_SAMPLER_ARG=1.0
PROMETHEUS_RETENTION=7d
TZ=Europe/Oslo

